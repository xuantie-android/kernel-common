CONFIG_ARCH_THEAD=y
CONFIG_CLK_THEAD_TH1520_VPSYS=y
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_PINCTRL_TH1520=y
CONFIG_GPIO_DWAPB=y
CONFIG_GPIO_PCA953X=y
CONFIG_PWM=y
# CONFIG_PWM_TH1520 is not set
CONFIG_PWM_TH1520_LPI4A_DEBUG=m
CONFIG_I2C=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_S6D6FT0=m
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_AIC_WLAN_SUPPORT=m
CONFIG_AIC8800_WLAN_SUPPORT=m
# CONFIG_AIC8800_BTLPM_SUPPORT is not set
# CONFIG_RTL8723BS is not set
CONFIG_DW_AXI_DMAC=y
CONFIG_SND_SOC_XUANTIE=y
CONFIG_SND_SOC_XUANTIE_TH1520_I2S=y
CONFIG_SND_SOC_XUANTIE_TH1520_HDMI_PCM=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_THEAD_TH1520_MBOX=y
CONFIG_TH1520_AON_PROTOCOL=y
CONFIG_TH1520_PM_DOMAINS=y
CONFIG_CPUFREQ_DT=y
CONFIG_REGULATOR_TH1520_AON=y
CONFIG_POWER_RESET_TH1520_AON=y
CONFIG_POWER_RESET_TH1520_WDT=y
CONFIG_RESET_TH1520=y
# Keep production hardening (CFI/SCS), but drop heavyweight lock and allocator
# diagnostics from the performance image. They dominate short syscalls and the
# Android RenderThread on C910.
# CONFIG_PROVE_LOCKING is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_LOCKDEP is not set
# CONFIG_RCU_TRACE is not set
CONFIG_POWER_SEQUENCING=m
CONFIG_POWER_SEQUENCING_TH1520_GPU=m
# Allow recovery from early boot hangs even when the UART adapter cannot send
# a real BREAK condition. Type this sequence followed by a SysRq command.
CONFIG_MAGIC_SYSRQ_SERIAL=y
CONFIG_MAGIC_SYSRQ_SERIAL_SEQUENCE="lpi4a-sysrq"
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_GENERIC_PLAT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT_EVDEV=y
CONFIG_VIDEO_HANTRO=m
CONFIG_VIDEO_HANTRO_THEAD=y
CONFIG_FB=y
CONFIG_FB_VIRTUAL=y
# Use the upstream DRM UAPI with Mesa's open-source PVR Vulkan driver.
CONFIG_DRM_POWERVR=m
# Use the GC620 2D engine for DMA-BUF blits and RGB/YUV conversion.
CONFIG_DRM_ETNAVIV=m
# CONFIG_DRM_POWERVR_ROGUE is not set
# Mainline TH1520 display pipeline.  Keep these modular during bring-up so the
# KMS card can be validated on a running board before it is made built-in.
CONFIG_DRM_VERISILICON_DC=m
CONFIG_DRM_THEAD_TH1520_DW_HDMI=m
CONFIG_DRM_DISPLAY_CONNECTOR=m
# Android uses userspace composition and does not need the DRM fbdev client.
# Keeping fbdev emulation enabled makes drm_client_lib depend on core client
# symbols that are absent from the currently running bring-up kernel, which
# prevents the display modules from being hot-loaded for validation.
# CONFIG_DRM_FBDEV_EMULATION is not set
# Legacy TH1520 gralloc is bridged to DMA-BUF heaps.  The DPU has no IOMMU,
# so keep a CMA heap large enough for several 1080p scanout buffers.
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_CMA_SIZE_MBYTES=256
CONFIG_STMMAC_ETH=m
CONFIG_DWMAC_THEAD=m
# CONFIG_DWMAC_GENERIC is not set
# CONFIG_DWMAC_SUN8I is not set
# CONFIG_DWMAC_SUNXI is not set
# CONFIG_DWMAC_SUN55I is not set
